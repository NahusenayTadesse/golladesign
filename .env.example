# Drizzle / MySQL
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@localhost:3306/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Uploaded files directory
FILES_DIR="files"

# Max request size for uploads (adapter-node defaults to 512K, which breaks gallery uploads)
BODY_SIZE_LIMIT="50M"

# SMTP (read at build time)
SMTP_HOST="mail.golladesigns.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
